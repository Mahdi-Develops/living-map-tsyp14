<?xml version="1.0"?>
<robot name="writer_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="ns" default="writer"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.30 0.30 0.10"/></geometry>
      <material name="orange"><color rgba="0.95 0.45 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.30 0.30 0.10"/></geometry>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <xacro:macro name="arm" params="name x y">
    <link name="${name}">
      <visual><geometry><cylinder radius="0.07" length="0.02"/></geometry>
        <material name="gray"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/><child link="${name}"/>
      <origin xyz="${x} ${y} 0.03" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:arm name="rotor_fl" x="0.18" y="0.18"/>
  <xacro:arm name="rotor_fr" x="0.18" y="-0.18"/>
  <xacro:arm name="rotor_bl" x="-0.18" y="0.18"/>
  <xacro:arm name="rotor_br" x="-0.18" y="-0.18"/>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.04" length="0.04"/></geometry></visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <gazebo reference="base_link">
    <gravity>0</gravity>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor type="ray" name="writer_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.02</resolution></range>
      </ray>
      <plugin name="writer_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>/$(arg ns)</namespace><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>$(arg ns)/lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="writer_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>/$(arg ns)</namespace></ros>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>$(arg ns)/odom</odometry_frame>
      <robot_base_frame>$(arg ns)/base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>
</robot>
