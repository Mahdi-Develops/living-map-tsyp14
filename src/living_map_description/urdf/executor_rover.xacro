<?xml version="1.0"?>
<robot name="executor_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="ns" default="executor"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.35 0.25 0.15"/></geometry>
      <material name="green"><color rgba="0.2 0.7 0.3 1"/></material>
    </visual>
    <collision><geometry><box size="0.35 0.25 0.15"/></geometry></collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual><geometry><cylinder radius="0.06" length="0.04"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual>
      <collision><geometry><cylinder radius="0.06" length="0.04"/></geometry></collision>
      <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/><child link="${name}"/>
      <origin xyz="${x} ${y} -0.05" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="wheel_fl" x="0.1" y="0.15"/>
  <xacro:wheel name="wheel_fr" x="0.1" y="-0.15"/>
  <xacro:wheel name="wheel_bl" x="-0.1" y="0.15"/>
  <xacro:wheel name="wheel_br" x="-0.1" y="-0.15"/>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.04" length="0.04"/></geometry></visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor type="ray" name="executor_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.02</resolution></range>
      </ray>
      <plugin name="executor_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><namespace>/$(arg ns)</namespace><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>$(arg ns)/lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="executor_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/$(arg ns)</namespace></ros>
      <left_joint>wheel_fl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <wheel_separation>0.3</wheel_separation>
      <wheel_diameter>0.12</wheel_diameter>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>$(arg ns)/odom</odometry_frame>
      <robot_base_frame>$(arg ns)/base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>
</robot>
